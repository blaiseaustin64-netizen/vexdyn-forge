# VEXDYN Forge — environment variables (Vite)
# Never put secrets here. These are public build-time values only.

# Deploy API Worker (Cloudflare Pages project deploys)
VITE_DEPLOY_API_URL=https://vexdyn-forge-deploy.YOUR_SUBDOMAIN.workers.dev

# Shared VEXDYN authentication backend (Cloudflare Worker)
# Default matches production if unset.
VITE_AUTH_API_URL=https://vexdyn-backend.blaisepatrick556.workers.dev
