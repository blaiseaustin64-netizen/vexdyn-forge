# Cloudflare Pages headers — production cache strategy for Forge

# HTML entry: always revalidate so users pick up new deployments
/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Build version endpoint: never cache (used for update detection)
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json

# Hashed Vite assets: long-lived immutable (filename changes when content changes)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Default for other static files
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
